{
  "name": "notetonmaster",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && pnpm build:worker",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/worker.js --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "next start",
    "worker:dev": "tsx watch --clear-screen=false worker/index.ts",
    "tokens": "tsx scripts/build-tokens.ts",
    "brand": "tsx scripts/build-brand.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project integration",
    "test:coverage": "vitest run --coverage",
    "test:data": "vitest run --config vitest.data.config.ts",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:full": "sh scripts/e2e-stack.sh run --project=e2e",
    "test:a11y": "playwright test --project=e2e tests/e2e/08-accessibility.spec.ts tests/e2e/44-admin-axe.spec.ts",
    "test:watch": "vitest",
    "seo:check": "tsx scripts/seo-check.ts",
    "e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:roles": "tsx scripts/db-roles.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "security:scan": "sh scripts/security-scan.sh",
    "smoke": "tsx scripts/smoke.ts",
    "links": "tsx scripts/links.ts",
    "lighthouse": "node scripts/lighthouse.mjs",
    "analyze": "next analyze --output && node scripts/analyze-js.mjs --route=/a-propos && node scripts/analyze-js.mjs --route=/parcours/[slug]",
    "budget": "sh scripts/budget.sh",
    "deploy:check": "sh scripts/deploy-check.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.3.1",
    "cron-parser": "^5.10.6",
    "csv-parse": "7.0.3",
    "iron-session": "^9.1.0",
    "marked": "^18.2.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "saxes": "^6.0.0",
    "server-only": "^0.0.1",
    "undici": "7.30.2",
    "yauzl": "^3.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/opentype.js": "^1.3.10",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/yauzl": "^3.4.0",
    "@vitest/coverage-v8": "5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "4.2.1",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  }
}
