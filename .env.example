# notetonmaster — environment variables.
# Copy to `.env` (`make dev` does it for you). Never commit real secrets.

# ---------- Database ----------
POSTGRES_USER=notetonmaster
POSTGRES_PASSWORD=notetonmaster
POSTGRES_DB=notetonmaster
# Host "db" is the compose service name.
DATABASE_URL=postgresql://notetonmaster:notetonmaster@db:5432/notetonmaster
# Integration tests (pnpm test:int): a separate database, dropped and recreated at each run. Its
# name must end with « _test »; the tests refuse the development database.
DATABASE_URL_TEST=postgresql://notetonmaster:notetonmaster@db:5432/notetonmaster_test
# Host port for Postgres (dev only, bound to 127.0.0.1).
DB_PORT=5432

# ---------- App ----------
# Public base URL, used in mails and links.
APP_URL=http://localhost:3000
APP_PORT=3000
# Session cookie secret: at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-0123456789abcdef
# 32-byte key (base64) for AES-256-GCM encryption at rest (emails, TOTP secrets) and HMAC lookups.
# Generate one with: openssl rand -base64 32
APP_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=

# Address of the site seen from the worker, to expire cache tags after a publication.
# INTERNAL_APP_URL=http://app:3000

# ---------- Mails ----------
# Dev: Mailpit (UI on http://localhost:8025). If SMTP_HOST is empty, mails are only logged.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="notetonmaster <ne-pas-repondre@notetonmaster.example>"

# ---------- Data ----------
# Run the seed after migrations when the dev stack starts (ignored in production).
SEED_ON_START=true
# "mock" (default: dev, tests, CI, never touches the network) or "live" (real connectors).
CONNECTORS_MODE=mock
# Raw snapshots of the data sources (Docker volume "rawdata", private).
RAW_DATA_DIR=/data/raw
# Shown in the robot's User-Agent (notetonmasterBot/1.0 (+<url>)) and on the « Notre robot » page.
CRAWLER_INFO_URL=http://localhost:3000/a-propos#notre-robot
CRAWLER_CONTACT_EMAIL=robot@notetonmaster.example
# Where verification documents are stored (Docker volume, never served publicly).
UPLOADS_DIR=/data/uploads

# ---------- Anti-robot: Cloudflare Turnstile ----------
# mock: dev, tests and CI. No network call; the token XXXX.DUMMY.TOKEN.XXXX is accepted and any
#       other token (e.g. "fail") refused. live: real Cloudflare keys (production).
TURNSTILE_MODE=mock
# Public site key and secret key of the Turnstile widget (dash.cloudflare.com → Turnstile).
# Official test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# true when the site sits behind Cloudflare: the visitor IP is then read from CF-Connecting-IP,
# only for requests that reach the origin from a Cloudflare address (section 11).
TRUST_CLOUDFLARE=false

# Rate limits are multiplied by this factor. The dev stack sets 20 (docker-compose.yml) because
# tests log the same demo accounts in many times; production keeps the real limits (1).
# RATE_LIMIT_MULTIPLIER=20

# ---------- Production ----------
# The production stack reads its own file, .env.prod: see .env.prod.example and
# docs/deploiement.md. Plain http pages for the collector (https only by default):
# CRAWLER_ALLOW_HTTP=false
# Search engines: only on https://notetonmaster.fr with PUBLIC_INDEXING=true (lib/seo/site.ts).
# PUBLIC_INDEXING=false

# Silence the Prisma CLI update banner.
PRISMA_HIDE_UPDATE_MESSAGE=1
