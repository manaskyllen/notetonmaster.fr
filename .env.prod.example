# notetonmaster — variables de production (docker-compose.prod.yml, docs/deploiement.md).
#
# Garde ce fichier dans un gestionnaire de mots de passe. Sans la même `APP_ENCRYPTION_KEY`, une
# sauvegarde restaurée ne peut plus lire les données chiffrées.
#
# Sur le serveur : `cp .env.prod.example .env.prod && chmod 600 .env.prod`, puis remplacer chaque
# valeur factice. Le vrai `.env.prod` n'est jamais commité (.gitignore). Le serveur refuse de
# démarrer avec une valeur manquante, de développement ou de test (lib/env.ts).

# ---------- Base de données ----------
# Compte propriétaire de la base : migrations, sauvegardes et restauration seulement.
POSTGRES_USER=notetonmaster
# Mot de passe du compte propriétaire (hexadécimal : il entre dans une URL) : openssl rand -hex 32
POSTGRES_PASSWORD=a-remplacer
# Nom de la base.
POSTGRES_DB=notetonmaster
# Mot de passe du rôle nm_app (site et worker : lignes seulement, aucun DDL) : openssl rand -hex 32
APP_DB_PASSWORD=a-remplacer
# Connexions du pool de chaque processus (vide : 12 pour le site, 4 pour le worker).
DB_POOL_MAX=

# ---------- Site ----------
# Adresse publique du site (https obligatoire) : liens des mails, canoniques, sitemaps.
APP_URL=https://notetonmaster.fr
# Secret des cookies de session, 32 caractères au moins : openssl rand -base64 48
SESSION_SECRET=change-me-openssl-rand-base64-48
# Clé de chiffrement des données (adresses, secrets TOTP), 32 octets en base64 : openssl rand -base64 32
# La même clé est indispensable pour relire une sauvegarde : à garder hors du serveur.
APP_ENCRYPTION_KEY=a-remplacer-openssl-rand-base64-32
# Indexation par les moteurs de recherche. false : robots.txt interdit tout, X-Robots-Tag noindex
# sur toutes les pages, sitemap vide. À passer à true en ouvrant les villes (docs/deploiement.md).
PUBLIC_INDEXING=false
# Clé IndexNow (signale les fiches modifiées à Bing et Yandex quand PUBLIC_INDEXING=true) : openssl rand -hex 16
INDEXNOW_KEY=
# Profils officiels du site dans le JSON-LD (adresses https séparées par des virgules), facultatif.
SEO_SAME_AS=

# ---------- Reverse proxy ----------
# Réseau Docker externe du reverse proxy, que seul le service app rejoint (alias notetonmaster-app).
PROXY_NETWORK=gateway
# Proxys devant l'app qui écrivent X-Forwarded-For : 1 (la passerelle Caddy, sans trusted_proxies).
TRUSTED_PROXY_HOPS=1
# true seulement si Cloudflare est placé devant la passerelle (lib/ip.ts).
TRUST_CLOUDFLARE=false
# true seulement avec un CDN qui met en cache les pages publiques anonymes (proxy.ts).
CDN_CACHE_PUBLIC=false

# ---------- Mails (SMTP d'OVH, depuis une adresse du domaine) ----------
# Adresses à créer chez OVH : docs/deploiement.md, section Mails.
# Serveur SMTP de l'offre mail OVH.
SMTP_HOST=ssl0.ovh.net
# 465 : TLS direct (587 : STARTTLS).
SMTP_PORT=465
# Boîte d'envoi créée chez OVH, qui sert d'identifiant SMTP (obligatoire avec SMTP_HOST). Personne
# ne la lit : les réponses partent vers CONTACT_EMAIL.
SMTP_USER=ne-pas-repondre@notetonmaster.fr
# Mot de passe de cette boîte (espace client OVH › E-mails).
SMTP_PASS=a-remplacer
# Expéditeur de tous les mails du site : la même adresse que SMTP_USER (SPF, DKIM et DMARC alignés).
MAIL_FROM="notetonmaster <ne-pas-repondre@notetonmaster.fr>"
# Adresse de contact de l'équipe (obligatoire) : Reply-To de tous les mails, adresse des mentions
# légales et de la page de confidentialité, contact du robot si CRAWLER_CONTACT_EMAIL est vide.
CONTACT_EMAIL=contact@notetonmaster.fr

# ---------- Anti-robot : Cloudflare Turnstile ----------
# live obligatoire en production.
TURNSTILE_MODE=live
# Clé publique du widget (dash.cloudflare.com › Turnstile, hôte notetonmaster.fr).
TURNSTILE_SITE_KEY=a-remplacer
# Clé secrète du même widget.
TURNSTILE_SECRET_KEY=a-remplacer

# ---------- Collecte des données ----------
# live obligatoire en production : les vrais connecteurs.
CONNECTORS_MODE=live
# Page publique qui présente le robot, envoyée dans son User-Agent (obligatoire, https).
CRAWLER_INFO_URL=https://notetonmaster.fr/a-propos#notre-robot
# Adresse de contact du robot, envoyée dans son User-Agent et affichée sur /a-propos#notre-robot :
# une redirection vers contact@ (vide : CONTACT_EMAIL).
CRAWLER_CONTACT_EMAIL=robot@notetonmaster.fr
# true autorise la lecture de pages publiques en http:// (https:// seulement par défaut).
CRAWLER_ALLOW_HTTP=false

# ---------- Ressources (pour ne pas gêner les autres applications du serveur) ----------
# Mémoire et processeurs du site.
APP_MEM_LIMIT=1g
APP_CPUS=1
# Mémoire et processeurs du worker (synchros). La première publication de Mon Master garde tout le
# catalogue en mémoire : 1536m et un tas de 1152 Mo pour le premier import, 1g ensuite suffit.
WORKER_MEM_LIMIT=1g
WORKER_CPUS=1
# Tas JavaScript du worker en Mo, environ 3/4 de WORKER_MEM_LIMIT (768 pour 1g, 1152 pour 1536m).
WORKER_HEAP_MB=768
# Mémoire et processeurs de PostgreSQL.
PG_MEM_LIMIT=1g
PG_CPUS=1
# Réglages de PostgreSQL, à garder en proportion de PG_MEM_LIMIT : shared_buffers ≈ 1/4,
# effective_cache_size ≈ 1/2, work_mem × max_connections bien en dessous (ici 8 Mo × 50).
PG_SHARED_BUFFERS=256MB
PG_EFFECTIVE_CACHE_SIZE=512MB
PG_WORK_MEM=8MB
PG_MAINTENANCE_WORK_MEM=64MB
# Connexions maximum : pools du site (12) et du worker (4), migrations, sauvegardes, marge.
PG_MAX_CONNECTIONS=50

# ---------- Journaux Docker ----------
# Taille d'un fichier de journal avant rotation.
LOG_MAX_SIZE=10m
# Fichiers gardés par conteneur.
LOG_MAX_FILE=3

# ---------- Sauvegardes (scripts/backup.sh) ----------
# Clé publique age des sauvegardes (age-keygen sur ton ordinateur ; la clé privée n'est jamais
# copiée sur le serveur).
BACKUP_AGE_RECIPIENT=age1a-remplacer
# Dossier des sauvegardes sur l'hôte, propre à notetonmaster.
BACKUP_DIR=/var/backups/notetonmaster
# Sauvegardes nocturnes gardées.
BACKUP_KEEP=7

# Bandeau de mise à jour de Prisma masqué.
PRISMA_HIDE_UPDATE_MESSAGE=1
